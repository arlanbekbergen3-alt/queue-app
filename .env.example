DB_PASSWORD=
JWT_SECRET_KEY=
TEACHER_INVITE_CODE=
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5434/queue_db

LOG_LEVEL=INFO
LOG_FORMAT=text
CORS_ORIGINS=[]
MAX_QUEUE_SIZE=300
MAX_ENTRIES_PER_SESSION=1000
NAME_MAX_LENGTH=60
SESSION_AUTO_CLOSE_HOURS=6
SESSION_REOPEN_HOURS=24
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_PER_MINUTE=6000
RATE_LIMIT_JOIN_PER_IP_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=20
RATE_LIMIT_TOKEN_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=400
SSE_ENABLED=true
SSE_MAX_PER_SESSION=400
DB_POOL_SIZE=30
DB_POOL_TIMEOUT_SECONDS=10

MAX_ASSIGNMENTS_PER_TEACHER=50
MAX_QUESTIONS_PER_ASSIGNMENT=200
MAX_CRITERIA_PER_ASSIGNMENT=20
ANALYTICS_MIN_SUBMISSIONS=5
ANALYTICS_OUTLIER_FACTOR=2.0
DEVIATION_MIN_SAMPLES=5
EXTREME_REASON_MIN_LENGTH=5

AI_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
AI_MODEL=qwen3.5:9b
AI_TIMEOUT_SECONDS=300
AI_MAX_SOURCE_CHARS=12000
AI_MAX_RESPONSE_CHARS=20000
AI_MAX_OUTPUT_TOKENS=3000
AI_MIN_QUESTIONS=8
AI_DRAFTS_PER_TEACHER_PER_HOUR=5
AI_PRACTICE_PER_IP_PER_HOUR=30
AI_PRACTICE_PER_SESSION_PER_HOUR=300
AI_PRACTICE_ANSWER_MAX_CHARS=1500
AI_PRACTICE_QUEUE_MAX=10
AI_PRACTICE_JOB_TTL_SECONDS=600
